# Target SIEM Log Ingestion Endpoint (Default: local SIEM backend)
SIEM_INGEST_URL=http://127.0.0.1:8000/api/logs/upload

# Local Dummy App Server Settings
DUMMY_APP_HOST=127.0.0.1
DUMMY_APP_PORT=5000

# Auto-forward events to SIEM immediately upon generation (true / false)
AUTO_FORWARD=false

# Optional API Token if the SIEM endpoint is configured with Bearer auth in custom setups
SIEM_API_TOKEN=
