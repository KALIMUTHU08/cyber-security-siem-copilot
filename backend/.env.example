# SIEM Copilot Backend Configuration
PROJECT_NAME="Cyber Security SIEM Copilot"
API_V1_STR="/api"
SECRET_KEY="development-secret-key-change-in-production"
DEBUG=True

# CORS - allowed origins for frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Database - SQLite by default; easily swapped for PostgreSQL later
DATABASE_URL="sqlite:///./siem_copilot.db"

# Optional LLM Configuration (fallback to deterministic template when empty)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
LLM_MODEL="gpt-4o-mini"
